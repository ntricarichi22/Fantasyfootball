NEXT_PUBLIC_SLEEPER_LEAGUE_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix either value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Required before security rollout; independent 32+ random bytes, server-only.
AUTH_SESSION_SECRET=
# 32+ random bytes used only for pseudonymous monitoring fingerprints.
AUDIT_HASH_KEY=
# Shared database-backed per-identifier login limiter (server-only).
AUTH_LOGIN_WINDOW_MINUTES=5
AUTH_LOGIN_ATTEMPTS_PER_WINDOW=10
# Required to enable AI. USD micros: $5/user and fixed $60 pilot defaults are in code.
AI_MONTHLY_USER_BUDGET_MICROS=5000000
AI_MONTHLY_PILOT_BUDGET_MICROS=60000000
AI_REQUESTS_PER_MINUTE=6
AI_MAX_CONCURRENT_PER_USER=2
# Required per deployed model; intentionally no unverified price defaults.
AI_PRICE_CLAUDE_SONNET_4_5_INPUT_MICROS_PER_MTOK=
AI_PRICE_CLAUDE_SONNET_4_5_OUTPUT_MICROS_PER_MTOK=
AI_PRICE_CLAUDE_SONNET_5_INPUT_MICROS_PER_MTOK=
AI_PRICE_CLAUDE_SONNET_5_OUTPUT_MICROS_PER_MTOK=
# Optional UUID charged for explicitly enabled scheduled/background AI.
AI_BACKGROUND_USER_ID=
# Optional email security alerts. Keep disabled until all four provider values
# are configured as private server secrets; never commit the real recipient.
SECURITY_EMAIL_ALERTS_ENABLED=false
SECURITY_ALERT_EMAIL_PROVIDER=resend
SECURITY_ALERT_EMAIL_TO=
SECURITY_ALERT_EMAIL_FROM=
RESEND_API_KEY=
SECURITY_ALERT_DEDUP_MINUTES=15
SECURITY_ALERT_MAX_PER_HOUR=12
SECURITY_ALERT_AI_REQUEST_MICROS=
