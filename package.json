{
  "name": "cfcdraftapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:security": "node --conditions=react-server --experimental-strip-types --test tests/security-session.test.ts",
    "test:ai": "node --conditions=react-server --experimental-strip-types --test tests/ai-limits.test.mjs",
    "test:audit": "node --conditions=react-server --experimental-strip-types --test src/infrastructure/security/audit.test.ts",
    "test:alerts": "node --conditions=react-server --experimental-strip-types --test src/infrastructure/security/alerts.test.ts",
    "test:authorization": "node --conditions=react-server --experimental-strip-types --test tests/security-authorization.test.ts",
    "test:handler-boundaries": "node --conditions=react-server --experimental-strip-types --test tests/security-handler-boundaries.test.ts",
    "test:integration-security": "node --conditions=react-server --experimental-strip-types --test tests/security-integration.test.mjs",
    "test:league": "node --conditions=react-server --experimental-strip-types --test tests/league-pick-identity.test.ts",
    "test:roster-values": "node --conditions=react-server --experimental-strip-types --test tests/roster-value-completeness.test.ts",
    "test:trade-parity": "node --conditions=react-server --experimental-strip-types --test tests/trade-grade-parity.test.ts",
    "test:framework-auth": "node scripts/test-next-auth-boundaries.mjs",
    "recovery:check": "bash -n scripts/recovery/validate-restore.sh && bash -n scripts/recovery/preflight-drill.sh && bash -n scripts/recovery/capture-baseline.sh && node --check scripts/recovery/exercise-synthetic-restore.mjs",
    "monitor:public": "node scripts/monitoring/verify-operations.mjs --public-only",
    "monitor:metadata": "node scripts/monitoring/verify-operations.mjs --metadata-only",
    "load:staging": "node scripts/load-staging.mjs",
    "test:historian": "node --conditions=react-server --experimental-strip-types --test tests/historian-sql.test.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "test": "node --conditions=react-server --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs src/infrastructure/security/*.test.ts scripts/monitoring/*.test.mjs scripts/recovery/*.test.mjs"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/supabase-js": "2.95.3",
    "cheerio": "^1.2.0",
    "lucide-react": "^0.574.0",
    "next": "16.4.6",
    "pg": "^8.20.0",
    "pgsql-ast-parser": "12.0.2",
    "playwright-core": "^1.58.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/blob": "2.9.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.6"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "engines": {
    "node": ">=22.13.0 <25"
  }
}
